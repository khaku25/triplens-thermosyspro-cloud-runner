{
  "schema_version": "TRIPLENS_EVENT_V1",
  "official_outputs": ["public/VPP_EVENT.csv", "public/ECMS_EVENT.csv"],
  "columns": [
    "schema_version",
    "run_id",
    "sequence",
    "same_time_order",
    "event_time_s",
    "event_time_ns",
    "source_time_s",
    "platform_time_s",
    "system",
    "source",
    "tag",
    "event_type",
    "state",
    "old_value",
    "new_value",
    "severity",
    "priority",
    "message",
    "quality",
    "logic_status",
    "provenance"
  ],
  "allowed_systems": ["DCS1", "DCS2", "ECMS"],
  "system_order": ["DCS1", "DCS2", "ECMS"],
  "allowed_event_types": [
    "COMMAND",
    "TRIP",
    "BREAKER",
    "PROTECTION",
    "PROCESS_ALARM",
    "RETURN",
    "STATE",
    "QUALITY"
  ],
  "allowed_severities": ["TRIP", "CRITICAL", "WARNING", "INFO"],
  "allowed_priorities": ["P1", "P2", "P3", "P4"],
  "allowed_quality": ["GOOD", "BAD", "UNCERTAIN"],
  "forbidden_columns": [
    "scenario",
    "scenario_id",
    "incident_id",
    "cause_id",
    "root_cause",
    "expected_root_cause",
    "diagnosis",
    "answer",
    "ground_truth",
    "label",
    "raw_row",
    "raw_payload",
    "raw_series"
  ],
  "forbidden_column_prefixes": [
    "scenario",
    "incident",
    "cause",
    "root_cause",
    "expected_cause",
    "diagnosis",
    "answer",
    "ground_truth",
    "fault_preset",
    "command_scenario",
    "raw"
  ],
  "timestamp_contract": {
    "canonical_clock": "VPP_SIMULATION_TIME",
    "precision": "INTEGER_NANOSECONDS",
    "sorting_key": "event_time_ns",
    "duplicate_time_policy": "PRESERVE_ALL_TRANSITIONS_WITH_SAME_TIME_ORDER",
    "resampling_allowed": false,
    "timestamp_shifting_allowed": false,
    "same_time_order_implies_causality": false
  },
  "boundary": {
    "public_directory_exact_files": ["ECMS_EVENT.csv", "VPP_EVENT.csv"],
    "internal_directory": "internal",
    "alarm_console_inputs": ["VPP_EVENT.csv", "ECMS_EVENT.csv"],
    "triplens_ai_inputs": ["DCS1", "DCS2", "ECMS"],
    "alarm_console_raw_access": false,
    "triplens_ai_raw_access": false,
    "scenario_answer_labels_allowed": false
  }
}
