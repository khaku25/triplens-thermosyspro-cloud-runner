{
  "schema": "triplens.kiee2026.workflow/v3",
  "workflow_name": "TripLens Incident Analysis",
  "release": "CURRENT_VALIDATION_BASELINE",
  "inputs": [
    {"name": "EVENT.csv", "role": "full_incident_event_stream"},
    {"name": "RAW.csv", "role": "historian_process_logic_state_evidence"}
  ],
  "time_contract": {
    "causal_order_field": "model_time_s",
    "audit_time_field": "wall_time_utc",
    "inter_sample_transition_policy": "represent_as_interval_when_exact_edge_is_not_observed"
  },
  "blind_policy": {
    "scenario_id_visible_to_agent": false,
    "expected_cause_visible_to_agent": false,
    "ground_truth_visible_to_agent": false,
    "answer_label_visible_to_agent": false,
    "simulation_only_fault_metadata_visible_to_agent": false,
    "operationally_observable_protection_and_logic_state_allowed": true
  },
  "steps": [
    {
      "id": "S01",
      "name": "Input Session and Time Validation",
      "owner": "python",
      "outputs": ["validated_input", "quality_flags"]
    },
    {
      "id": "S02",
      "name": "Evidence Store Construction",
      "owner": "python",
      "outputs": ["event_store", "raw_store", "evidence_ids", "exact_tag_mapping"]
    },
    {
      "id": "S03",
      "name": "Bounded Evidence Tool Loop",
      "owner": "python_and_gemini",
      "tools": [
        "search_events",
        "get_event_window",
        "get_raw_window",
        "get_tag_series",
        "get_logic_context",
        "get_equipment_state"
      ],
      "max_total_tool_calls": 8,
      "note": "Gemini selects tools; Python executes them. The full historian is not initially serialized into the prompt."
    },
    {
      "id": "S04",
      "name": "Gemini Incident Reasoning",
      "owner": "gemini",
      "outputs": [
        "critical_events",
        "primary_cause_or_candidate",
        "direct_trigger",
        "propagation",
        "causal_chain",
        "counter_evidence",
        "additional_evidence_required",
        "affected_equipment",
        "operator_checks"
      ]
    },
    {
      "id": "S05",
      "name": "Claim Local Citation Check",
      "owner": "python",
      "note": "A maximum of one citation-only correction may use already retrieved evidence. No additional tool call is granted by the correction."
    },
    {
      "id": "S06",
      "name": "Verification Gate",
      "owner": "python",
      "checks": [
        "evidence_id_exists",
        "claim_tag_linkage",
        "structured_output_contract",
        "supported_time_or_interval",
        "forbidden_answer_metadata_not_used"
      ],
      "allowed_gate_status": ["PASS", "HOLD"]
    },
    {
      "id": "S07",
      "name": "Human Review and Failure Report",
      "owner": "human",
      "outputs": ["reviewed_incident_brief", "failure_report_draft"],
      "note": "Gate PASS is not final engineering approval or restart authorization."
    }
  ],
  "claim_status": ["OBSERVED", "CANDIDATE", "UNKNOWN"],
  "safety": {
    "read_only": true,
    "ot_write": false,
    "automatic_restoration": false,
    "automatic_breaker_operation": false,
    "fail_closed": true
  },
  "validation_baseline": {
    "distinct_synthetic_scenarios": 12,
    "cumulative_analysis_executions_including_revalidation": 21,
    "inspection_items_per_scenario": 20,
    "site_analysis_final_reports": 12,
    "internal_engineering_inspection_mean_score_baseline": 88.0,
    "score_interpretation": "Internal composite engineering inspection score; not AI accuracy.",
    "field_validation": false,
    "representative_fail_closed_case": "09_hp_bfp_raw_missing_interval"
  },
  "generalization_boundary": {
    "validated": "Multiple incident types within the same Current V8 synthetic combined-cycle environment.",
    "not_validated": [
      "real_power_plant_field_accuracy",
      "all_power_plant_topologies",
      "vendor_specific_real_equipment_interoperability",
      "production_safety_performance"
    ]
  }
}
