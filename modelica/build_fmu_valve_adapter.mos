setCommandLineOptions("--std=3.4");
loadModel(Modelica, {"3.2.3"});
getErrorString();
loadFile("/workspace/vendor/ThermoSysPro/ThermoSysPro/package.mo");
getErrorString();
loadFile("/workspace/build/TripLens_CombinedCycle_TripTAC.mo");
getErrorString();
loadFile("/workspace/modelica/TripLens_Valve_Adapter_Smoke.mo");
getErrorString();
loadFile("/workspace/modelica/TripLens_Valve_Adapter_All_Smoke.mo");
getErrorString();
cd("/workspace/build");
simulate(
  TripLens_CombinedCycle_TripTAC,
  startTime=0,
  stopTime=2,
  numberOfIntervals=20,
  tolerance=1e-3,
  method="dassl",
  outputFormat="csv",
  simflags="-noEventEmit",
  fileNamePrefix="valve_auto_baseline",
  variableFilter="^(time|fmuVlv.*(AutoCmd|Cmd|Fb|Deviation|FaultActive|Cv|MassFlow|Dp)|vanne_vapeurHP\.(Cv|Q|deltaP)|vanne_entree_TurbineMP\.(Cv|Q|deltaP))$");
getErrorString();
simulate(
  TripLens_Valve_Adapter_Smoke,
  startTime=0,
  stopTime=2,
  numberOfIntervals=20,
  tolerance=1e-3,
  method="dassl",
  outputFormat="csv",
  simflags="-noEventEmit",
  fileNamePrefix="valve_manual_fault_smoke",
  variableFilter="^(time|fmuVlv.*(AutoCmd|Cmd|Fb|Deviation|FaultActive|Cv|MassFlow|Dp)|vanne_vapeurHP\.(Cv|Q|deltaP)|vanne_entree_TurbineMP\.(Cv|Q|deltaP))$");
getErrorString();
simulate(
  TripLens_Valve_Adapter_All_Smoke,
  startTime=0,
  stopTime=2,
  numberOfIntervals=20,
  tolerance=1e-3,
  method="dassl",
  outputFormat="csv",
  simflags="-noEventEmit",
  fileNamePrefix="valve_all_manual_smoke",
  variableFilter="^(time|fmuVlv.*(AutoCmd|Cmd|Fb|Deviation|FaultActive|Cv|MassFlow|Dp))$");
getErrorString();
buildModelFMU(
  TripLens_CombinedCycle_TripTAC,
  version="2.0",
  fmuType="cs",
  fileNamePrefix="TripLens_Native_Valve_Control_V1");
getErrorString();
