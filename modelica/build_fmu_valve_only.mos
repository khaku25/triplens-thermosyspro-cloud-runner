setCommandLineOptions("--std=3.4");
loadModel(Modelica, {"3.2.3"});
getErrorString();
loadFile("/workspace/vendor/ThermoSysPro/ThermoSysPro/package.mo");
getErrorString();
loadFile("/workspace/build/TripLens_CombinedCycle_TripTAC.mo");
getErrorString();
loadFile("/workspace/modelica/TripLens_FMU_Valve_Export.mo");
getErrorString();
setIndexReductionMethod("dummyDerivatives");
getErrorString();
cd("/workspace/build");
buildModelFMU(
  TripLens_FMU_Valve_Export,
  version="2.0",
  fmuType="cs",
  fileNamePrefix="TripLens_Native_Valve_Control_V1");
getErrorString();
